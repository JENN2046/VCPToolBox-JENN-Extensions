# Non-secret example only. Keep actual config.env local and out of Git.
# Existing ToolBox plugin configSchema/config.env loader supplies these values.
JSO_LOCAL_AGENT_ENDPOINT=http://127.0.0.1:3800/api/v2/agent/tools
JSO_RESOURCE_IDS=RESOURCE_EXAMPLE
JSO_CALL_POLICY=read-only
JSO_MAX_SHIFT_MINUTES=240
# Supply JSO_LOCAL_AGENT_TOKEN using the existing plugin-local config injection.
# No token value is supplied here; do not use an Owner/SUVEI/model credential.
# native-direct-and-confirm requires the separately admitted generic native host bridge.
# Merely changing the policy never permits model/stdin reschedule calls.
# Host-owned persistent operation journal, outside the source checkout.
JSO_JOURNAL_PATH=/absolute/private/runtime/jso/conversation
JSO_ASSISTANT_SUBJECT_ID=EXISTING_ASSISTANT_SUBJECT
# Required only when multiple resources are configured.
JSO_DEFAULT_RESOURCE_ID=RESOURCE_EXAMPLE
